rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() { return request.auth != null && request.auth.uid == 'L68wvCIRkaeIBiFodG2HP6EySJB3'; }
    match /masihiGeetAdmins/{email} {
      allow get: if request.auth != null && request.auth.token.email == email;
      allow list, create, update, delete: if owner();
    }
  }
}
